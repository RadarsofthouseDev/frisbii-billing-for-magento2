<?php /* @var $block \Radarsofthouse\BillwerkPlusSubscription\Block\Adminhtml\System\Config\WebhookSecret */ ?>
<script>
    require(['jquery'], function(jQuery) {
        var secretSpan = jQuery('#subscription_webhook_secret_span');
        var secretButton = jQuery('#subscription_webhook_secret_button');
        var secretMessage = secretSpan.find('.webhook_secret_message_span');

        secretButton.click(function() {
            jQuery.ajax({
                url: '<?= $escaper->escapeUrl($block->getAjaxUrl()) ?>',
                type: 'POST',
                dataType: 'json',
                data: {
                    form_key: jQuery('input[name="form_key"]').first().val()
                },
                beforeSend: function() {
                    secretButton.prop('disabled', true);
                    secretSpan.find('.processing').show();
                    secretSpan.find('.updated').hide();
                    secretMessage.text('').css('color', '#e22626');
                },
                complete: function() {
                    secretButton.prop('disabled', false);
                    secretSpan.find('.processing').hide();
                },
                success: function(data, textStatus, jqXHR) {
                    var response = jqXHR.responseJSON || data || {};
                    var message = response.message || 'Webhook secret synchronization failed.';
                    if (response.success === true) {
                        secretSpan.find('.updated').show();
                    }
                    if (response.synced && response.synced.length) {
                        message += ' Synced: ' + response.synced.length + '.';
                    }
                    if (response.failed && response.failed.length) {
                        message += ' Failed: ' + response.failed.length + '.';
                    }
                    if (response.skipped && response.skipped.length) {
                        message += ' Skipped: ' + response.skipped.length + '.';
                    }
                    if (response.removed && response.removed.length) {
                        message += ' Removed: ' + response.removed.length + '.';
                    }
                    secretMessage.text(message).css(
                        'color',
                        response.success === true ? '#32CD32' : '#e22626'
                    );
                },
                error: function(response) {
                    secretMessage.text(
                        response.statusText || 'Webhook secret synchronization failed.'
                    ).css('color', '#e22626');
                }
            });
        });
    });
</script>

<?= $block->getButtonHtml() ?>
<span class="collect-indicator" id="subscription_webhook_secret_span">
    <img class="processing" hidden="hidden" alt="Processing" style="margin:0 5px"
        src="<?= $escaper->escapeUrl($block->getViewFileUrl('images/process_spinner.gif')) ?>" />
    <img class="updated" hidden="hidden" alt="Updated" style="margin:-3px 5px"
        src="<?= $escaper->escapeUrl($block->getViewFileUrl('images/rule_component_apply.gif')) ?>" />
    <span class="webhook_secret_message_span" style="color: red; font-size: 12px;"></span>
</span>
