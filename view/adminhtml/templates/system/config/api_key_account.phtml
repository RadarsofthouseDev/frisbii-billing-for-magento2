<?php
/* @var $block \Radarsofthouse\BillwerkPlusSubscription\Block\Adminhtml\System\Config\ApiKeyAccount */
$environment = $block->getEnvironment();
$statusId = $block->getStatusId();
?>
<div id="<?= $escaper->escapeHtmlAttr($statusId) ?>">
    <img class="billwerkplus-api-key-account-updated" hidden="hidden" alt="Loaded" style="margin:-3px 5px"
        src="<?= $escaper->escapeUrl($block->getViewFileUrl('images/rule_component_apply.gif')) ?>" />
    <img class="billwerkplus-api-key-account-error" hidden="hidden" alt="Error" style="margin:-1px 5px"
        src="<?= $escaper->escapeUrl($block->getViewFileUrl('images/rule_component_remove.gif')) ?>" />
    <span class="billwerkplus-api-key-account-message">Checking account...</span>
</div>
<script>
    require(['jquery'], function(jQuery) {
        jQuery(function() {
            var environment = '<?= $escaper->escapeJs($environment) ?>';
            var statusContainer = jQuery('#<?= $escaper->escapeHtmlAttr($statusId) ?>');
            var messageElement = statusContainer.find('.billwerkplus-api-key-account-message');
            var updatedIcon = statusContainer.find('.billwerkplus-api-key-account-updated');
            var errorIcon = statusContainer.find('.billwerkplus-api-key-account-error');

            var renderStatus = function(response, data) {
                updatedIcon.hide();
                errorIcon.hide();
                var responseData = response.responseJSON || data;
                if (response.status < 200 || response.status >= 300 || !responseData) {
                    messageElement.text('Unable to connect to Frisbii.').css('color', '#e22626');
                    errorIcon.show();
                    return;
                }

                var accountLabels = {};
                var invalidApiKey = false;
                var connectionFailed = false;
                var frisbiiError = false;
                (responseData.statuses || []).forEach(function(status) {
                    if (status.environment !== environment) {
                        return;
                    }
                    if (status.account) {
                        accountLabels[status.account.name + ' (' + status.account.handle + ')'] = true;
                    } else if (status.error === 'invalid_api_key') {
                        invalidApiKey = true;
                    } else if (status.error === 'connection') {
                        connectionFailed = true;
                    } else {
                        frisbiiError = true;
                    }
                });

                var labels = Object.keys(accountLabels);
                if (labels.length > 0 && !invalidApiKey && !connectionFailed && !frisbiiError) {
                    updatedIcon.show();
                    messageElement.text(labels.join('; ')).css('color', '#32CD32');
                } else if (invalidApiKey) {
                    messageElement.text('Invalid API key.').css('color', '#e22626');
                    errorIcon.show();
                } else if (connectionFailed) {
                    messageElement.text('Unable to connect to Frisbii.').css('color', '#e22626');
                    errorIcon.show();
                } else if (frisbiiError) {
                    messageElement.text('Unable to verify API key.').css('color', '#e22626');
                    errorIcon.show();
                } else {
                    messageElement.text('Not configured.').css('color', '#e22626');
                    errorIcon.show();
                }
            };

            window.billwerkPlusApiKeyAccountCallbacks = window.billwerkPlusApiKeyAccountCallbacks || [];
            window.billwerkPlusApiKeyAccountCallbacks.push(renderStatus);

            if (window.billwerkPlusApiKeyAccountResponse) {
                renderStatus(window.billwerkPlusApiKeyAccountResponse);
                return;
            }

            if (window.billwerkPlusApiKeyAccountRequestStarted) {
                return;
            }

            window.billwerkPlusApiKeyAccountRequestStarted = true;

            jQuery.ajax({
                url: '<?= $escaper->escapeUrl($block->getAjaxUrl()) ?>',
                type: 'GET',
                dataType: 'json',
                cache: false,
                success: function(data, textStatus, jqXHR) {
                    window.billwerkPlusApiKeyAccountResponse = jqXHR;
                    window.billwerkPlusApiKeyAccountCallbacks.forEach(function(callback) {
                        callback(jqXHR, data);
                    });
                },
                error: function(jqXHR) {
                    window.billwerkPlusApiKeyAccountResponse = jqXHR;
                    window.billwerkPlusApiKeyAccountCallbacks.forEach(function(callback) {
                        callback(jqXHR);
                    });
                }
            });
        });
    });
</script>